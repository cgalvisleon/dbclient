{
  "name": "dbclient",
  "displayName": "DB Client",
  "description": "Database client for PostgreSQL, MySQL, SQL Server, Oracle, SQLite, Redis and NATS.",
  "version": "0.3.0",
  "publisher": "cgalvisleon",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "postgres",
    "redis",
    "nats"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:redis"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbclient",
          "title": "DB Client",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "dbclientResults",
          "title": "DB Client",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbclient": [
        {
          "id": "dbclient.connections",
          "name": "Connections"
        }
      ],
      "dbclientResults": [
        {
          "type": "webview",
          "id": "dbclient.results",
          "name": "Results"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbclient.connections",
        "contents": "No connections yet.\n[Add Connection](command:dbclient.addConnection)"
      }
    ],
    "commands": [
      {
        "command": "dbclient.addConnection",
        "title": "Add Connection",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/database-add.png",
          "dark": "media/icons/database-add.png"
        }
      },
      {
        "command": "dbclient.refresh",
        "title": "Refresh",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/refresh.png",
          "dark": "media/icons/refresh.png"
        }
      },
      {
        "command": "dbclient.editConnection",
        "title": "Edit Connection",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/database-settings.png",
          "dark": "media/icons/database-settings.png"
        }
      },
      {
        "command": "dbclient.duplicateConnection",
        "title": "Duplicate Connection",
        "category": "DB Client"
      },
      {
        "command": "dbclient.deleteConnection",
        "title": "Delete Connection",
        "category": "DB Client"
      },
      {
        "command": "dbclient.testConnection",
        "title": "Test Connection",
        "category": "DB Client"
      },
      {
        "command": "dbclient.connect",
        "title": "Connect",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/database-connect.png",
          "dark": "media/icons/database-connect.png"
        }
      },
      {
        "command": "dbclient.disconnect",
        "title": "Disconnect",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/database-remove.png",
          "dark": "media/icons/database-remove.png"
        }
      },
      {
        "command": "dbclient.newQuery",
        "title": "New Query",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/sql-file.png",
          "dark": "media/icons/sql-file.png"
        }
      },
      {
        "command": "dbclient.selectConnection",
        "title": "Select Connection for Editor",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/database.png",
          "dark": "media/icons/database.png"
        }
      },
      {
        "command": "dbclient.run",
        "title": "Run Selection or Statement / Line",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/run-query.png",
          "dark": "media/icons/run-query.png"
        }
      },
      {
        "command": "dbclient.runFile",
        "title": "Run File",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/query.png",
          "dark": "media/icons/query.png"
        }
      },
      {
        "command": "dbclient.cancelQuery",
        "title": "Cancel Running Query",
        "category": "DB Client"
      },
      {
        "command": "dbclient.runAt",
        "title": "Run Statement at Position",
        "category": "DB Client"
      },
      {
        "command": "dbclient.openConsole",
        "title": "Open NATS Console",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/terminal.png",
          "dark": "media/icons/terminal.png"
        }
      },
      {
        "command": "dbclient.unsubscribe",
        "title": "Unsubscribe",
        "category": "DB Client"
      },
      {
        "command": "dbclient.openValue",
        "title": "Open Value",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/authentication.png",
          "dark": "media/icons/authentication.png"
        }
      },
      {
        "command": "dbclient.addFolder",
        "title": "New Folder",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/add-folder.png",
          "dark": "media/icons/add-folder.png"
        }
      },
      {
        "command": "dbclient.renameFolder",
        "title": "Rename Folder",
        "category": "DB Client"
      },
      {
        "command": "dbclient.deleteFolder",
        "title": "Delete Folder",
        "category": "DB Client",
        "icon": {
          "light": "media/icons/light/remove-folder.png",
          "dark": "media/icons/remove-folder.png"
        }
      },
      {
        "command": "dbclient.moveToFolder",
        "title": "Move to Folder…",
        "category": "DB Client"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbclient.addConnection",
          "when": "view == dbclient.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbclient.addFolder",
          "when": "view == dbclient.connections",
          "group": "navigation@2"
        },
        {
          "command": "dbclient.refresh",
          "when": "view == dbclient.connections",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "dbclient.newQuery",
          "when": "view == dbclient.connections && viewItem =~ /^(connection|database)\\b/ && viewItem =~ /\\b(sql|kv)\\b/",
          "group": "inline@1"
        },
        {
          "command": "dbclient.openConsole",
          "when": "view == dbclient.connections && viewItem =~ /^(connection|subscription)\\b/ && viewItem =~ /\\bpubsub\\b/",
          "group": "inline@1"
        },
        {
          "command": "dbclient.connect",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b.*\\bdisconnected\\b/",
          "group": "inline@2"
        },
        {
          "command": "dbclient.disconnect",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b.*\\bconnected\\b/",
          "group": "inline@2"
        },
        {
          "command": "dbclient.newQuery",
          "when": "view == dbclient.connections && viewItem =~ /^(connection|database)\\b/ && viewItem =~ /\\b(sql|kv)\\b/",
          "group": "1_query@1"
        },
        {
          "command": "dbclient.openConsole",
          "when": "view == dbclient.connections && viewItem =~ /^(connection|subscription)\\b/ && viewItem =~ /\\bpubsub\\b/",
          "group": "1_query@2"
        },
        {
          "command": "dbclient.openValue",
          "when": "view == dbclient.connections && viewItem =~ /^key\\b/",
          "group": "1_query@3"
        },
        {
          "command": "dbclient.unsubscribe",
          "when": "view == dbclient.connections && viewItem =~ /^subscription\\b/",
          "group": "1_query@4"
        },
        {
          "command": "dbclient.connect",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b.*\\bdisconnected\\b/",
          "group": "2_state@1"
        },
        {
          "command": "dbclient.disconnect",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b.*\\bconnected\\b/",
          "group": "2_state@2"
        },
        {
          "command": "dbclient.testConnection",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b/",
          "group": "2_state@3"
        },
        {
          "command": "dbclient.editConnection",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b/",
          "group": "3_edit@1"
        },
        {
          "command": "dbclient.duplicateConnection",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b/",
          "group": "3_edit@2"
        },
        {
          "command": "dbclient.deleteConnection",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b/",
          "group": "3_edit@3"
        },
        {
          "command": "dbclient.addConnection",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "inline@1"
        },
        {
          "command": "dbclient.addFolder",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "inline@2"
        },
        {
          "command": "dbclient.addConnection",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "1_folder@1"
        },
        {
          "command": "dbclient.addFolder",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "1_folder@2"
        },
        {
          "command": "dbclient.renameFolder",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "3_edit@1"
        },
        {
          "command": "dbclient.moveToFolder",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "3_edit@2"
        },
        {
          "command": "dbclient.deleteFolder",
          "when": "view == dbclient.connections && viewItem == connectionFolder",
          "group": "3_edit@3"
        },
        {
          "command": "dbclient.moveToFolder",
          "when": "view == dbclient.connections && viewItem =~ /^connection\\b/",
          "group": "3_edit@4"
        }
      ],
      "editor/title": [
        {
          "command": "dbclient.selectConnection",
          "when": "editorLangId == sql || editorLangId == redis",
          "group": "navigation@0"
        },
        {
          "command": "dbclient.run",
          "when": "editorLangId == sql || editorLangId == redis",
          "group": "navigation@1"
        },
        {
          "command": "dbclient.runFile",
          "when": "editorLangId == sql || editorLangId == redis",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "dbclient.editConnection",
          "when": "false"
        },
        {
          "command": "dbclient.duplicateConnection",
          "when": "false"
        },
        {
          "command": "dbclient.runAt",
          "when": "false"
        },
        {
          "command": "dbclient.unsubscribe",
          "when": "false"
        },
        {
          "command": "dbclient.openValue",
          "when": "false"
        },
        {
          "command": "dbclient.run",
          "when": "editorLangId == sql || editorLangId == redis"
        },
        {
          "command": "dbclient.runFile",
          "when": "editorLangId == sql || editorLangId == redis"
        },
        {
          "command": "dbclient.renameFolder",
          "when": "false"
        },
        {
          "command": "dbclient.deleteFolder",
          "when": "false"
        },
        {
          "command": "dbclient.moveToFolder",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbclient.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == redis)"
      },
      {
        "command": "dbclient.runFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == redis)"
      }
    ],
    "configuration": {
      "title": "DB Client",
      "properties": {
        "dbclient.maxRows": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum number of rows fetched per statement. Larger result sets are truncated."
        },
        "dbclient.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "Rows per page in the results grid."
        },
        "dbclient.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a Run action above each statement in SQL editors bound to a connection."
        }
      }
    },
    "languages": [
      {
        "id": "redis",
        "aliases": [
          "Redis",
          "redis"
        ],
        "extensions": [
          ".redis"
        ],
        "configuration": "./syntaxes/redis.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "redis",
        "scopeName": "source.redis",
        "path": "./syntaxes/redis.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node test/smoke/run.mjs",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "node esbuild.mjs --production",
    "icons": "node scripts/build-icons.mjs"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "nats": "^2.29.3",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
  "author": "Cesar Galvis Leon",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/cgalvisleon/dbclient.git"
  },
  "homepage": "https://github.com/cgalvisleon/dbclient#readme",
  "bugs": {
    "url": "https://github.com/cgalvisleon/dbclient/issues"
  }
}
