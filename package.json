        },
        {
          "command": "dbclient.deleteFolder",
          "when": "false"
        },
        {
          "command": "dbclient.moveToFolder",
          "when": "false"
        },
        {
          "command": "dbclient.setFolderColor",
          "when": "dbclient.hasFolders"
        },
        {
          "command": "dbclient.renameSqlFile",
          "when": "false"
        },
        {
          "command": "dbclient.deleteSqlFile",
          "when": "false"
        },
        {
          "command": "dbclient.saveToSqlFolder",
          "when": "editorLangId == sql"
        },
        {
          "command": "dbclient.removeSqlFolder",
          "when": "false"
        },
        {
          "command": "dbclient.openData",
          "when": "false"
        },
        {
          "command": "dbclient.openSql",
          "when": "false"
        },
        {
          "command": "dbclient.showStructure",
          "when": "false"
        },
        {
          "command": "dbclient.showDdl",
          "when": "false"
        },
        {
          "command": "dbclient.generateSelect",
          "when": "false"
        },
        {
          "command": "dbclient.generateInsert",
          "when": "false"
        },
        {
          "command": "dbclient.generateUpdate",
          "when": "false"
        },
        {
          "command": "dbclient.generateDelete",
          "when": "false"
        },
        {
          "command": "dbclient.refreshNode",
          "when": "false"
        },
        {
          "command": "dbclient.drop",
          "when": "false"
        }
      ],
      "dbclient.generateSql": [
        {
          "command": "dbclient.generateSelect",
          "group": "1@1"
        },
        {
          "command": "dbclient.generateInsert",
          "when": "viewItem =~ /^table sql\\b/",
          "group": "1@2"
        },
        {
          "command": "dbclient.generateUpdate",
          "when": "viewItem =~ /^table sql\\b/",
          "group": "1@3"
        },
        {
          "command": "dbclient.generateDelete",
          "when": "viewItem =~ /^table sql\\b/",
          "group": "1@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbclient.run",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == redis)"
      },
      {
        "command": "dbclient.runFile",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "editorTextFocus && (editorLangId == sql || editorLangId == redis)"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "dbclient.maxRows": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "%config.dbclient.maxRows.description%"
        },
        "dbclient.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "description": "%config.dbclient.pageSize.description%"
        },
        "dbclient.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "%config.dbclient.codeLens.description%"
        },
        "dbclient.sqlFolder": {
          "type": "string",
          "default": "",
          "description": "%config.dbclient.sqlFolder.description%"
        },
        "dbclient.historySize": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "%config.dbclient.historySize.description%"
        }
      }
    },
    "languages": [
      {
        "id": "redis",
        "aliases": [
          "Redis",
          "redis"
        ],
        "extensions": [
          ".redis"
        ],
        "configuration": "./syntaxes/redis.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "redis",
        "scopeName": "source.redis",
        "path": "./syntaxes/redis.tmLanguage.json"
      }
    ],
    "submenus": [
      {
        "id": "dbclient.generateSql",
        "label": "%submenu.dbclient.generateSql%"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --no-file-parallelism",
    "test:smoke": "npm run build && node test/smoke/run.mjs",
    "package": "npm run typecheck && node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "icons": "node scripts/build-icons.mjs",
    "publish:ovsx": "npm run package && ovsx publish dbclient-$npm_package_version.vsix",
    "publish:vsce": "npm run package && vsce publish --no-dependencies --packagePath dbclient-$npm_package_version.vsix"
  },
  "dependencies": {
    "ioredis": "^6.0.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "nats": "^2.29.3",
    "oracledb": "^26.0.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
