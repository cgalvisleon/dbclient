    "@types/mssql": "^12.3.0",
    "@types/node": "^22.0.0",
    "@types/oracledb": "^7.0.3",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/ssh2": "^1.15.1",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^24.1.3",
    "ovsx": "^0.10.12",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  },
